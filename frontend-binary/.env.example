# Binary markets (Sepolia). After deploy run: npm run sync-deploy (or set these from deploy-addresses-binary.json)
VITE_BINARY_FACTORY=0xc378bD4420072e3f997610E81605d203D1BC0466
VITE_BINARY_MARKET_0=0x9D91287C44455982ceAeB8889Db9f53dC188fC94
VITE_COLLATERAL=0x799a5570318c0C5Fcfd09b0f573335B5aa8d85Ff

# Sepolia RPC — use the same URL as repo root SEPOLIA_RPC_URL but name it VITE_SEPOLIA_RPC_URL (Vite only exposes VITE_* vars)
# Example: VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# WalletConnect project ID — get a free one at https://cloud.walletconnect.com (avoids 403 from modal)
# VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Optional: matcher API for order book / place order (e.g. http://localhost:3001)
# VITE_MATCHER_API=http://localhost:3001
